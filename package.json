{
  "name": "echo-satellite-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"node --env-file-if-exists=.env server/start.mjs\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/start.mjs",
    "test": "node --test src/*.test.mjs server/*.test.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "globe.gl": "^2.45.0",
    "satellite.js": "^7.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "vite": "^7.1.0"
  }
}
